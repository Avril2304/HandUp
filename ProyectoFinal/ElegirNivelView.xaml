<UserControl x:Class="ProyectoFinal.ElegirNivelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="Vista_PreviewKeyDown">
    <!-- Paso 1 de Aprender: los 4 niveles en una grilla de 2x2. Teclas 1-4 para elegir. -->
    <Grid>
        <!-- El margen negativo compensa el espacio que deja cada tarjeta a su derecha y abajo -->
        <ItemsControl x:Name="lstNiveles" Focusable="False" Margin="0,0,-14,-14">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="2" Columns="2"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource MenuTile}" Margin="0,0,14,14" Click="Nivel_Click"
                            AutomationProperties.Name="{Binding NombreAccesible}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- "Tu nivel" (solo en el nivel actual del perfil) y la tecla del atajo -->
                            <Border CornerRadius="10" Padding="10,3" HorizontalAlignment="Left"
                                    Background="{DynamicResource BrushAccent}" Visibility="{Binding VisibilidadTuNivel}">
                                <TextBlock Text="Tu nivel" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource BrushOnAccent}"/>
                            </Border>
                            <Border Style="{StaticResource AtajoBadge}">
                                <TextBlock Text="{Binding Numero}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushAccentDark}"/>
                            </Border>

                            <TextBlock Grid.Row="1" Text="{Binding Nombre}" FontFamily="{StaticResource FontHeading}"
                                       FontSize="22" FontWeight="Bold" Margin="0,10,0,0"/>
                            <TextBlock Grid.Row="2" Text="{Binding Descripcion}" FontSize="13"
                                       Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>

                            <TextBlock Grid.Row="3" Text="{Binding Categorias}" FontSize="12.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource BrushMuted}" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>

                            <TextBlock Grid.Row="4" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" Margin="0,8,0,0">
                                <Run Text="{Binding CantidadSenas, Mode=OneWay}"/><Run Text=" señas  →"/>
                            </TextBlock>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Si la base no responde, se muestra esto en lugar de la grilla -->
        <TextBlock x:Name="lblError" Visibility="Collapsed" FontSize="14" TextWrapping="Wrap"
                   Foreground="{DynamicResource BrushError}" VerticalAlignment="Top"/>
    </Grid>
</UserControl>
