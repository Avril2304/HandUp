<UserControl x:Class="ProyectoFinal.PracticaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ProyectoFinal"
             PreviewKeyDown="Vista_PreviewKeyDown">
    <!-- Práctica de una categoría: preguntas de opción múltiple y de tipeo sobre sus señas.
         Izquierda: la seña (visor). Derecha: la pregunta, la respuesta y el resultado. -->
    <Grid>
        <!-- ===== Preguntas ===== -->
        <Grid x:Name="pnlPregunta">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="26"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <local:VisorSena x:Name="visor" Grid.Column="0"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Avance: "Pregunta 3 de 10" y una barra -->
                <StackPanel Grid.Row="0">
                    <TextBlock x:Name="lblAvance" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource BrushMuted}"/>
                    <Border Height="6" CornerRadius="3" Margin="0,6,0,0" Background="{DynamicResource BrushTrack}" ClipToBounds="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="colAvanceLleno" Width="0*"/>
                                <ColumnDefinition x:Name="colAvanceVacio" Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="3" Background="{DynamicResource BrushAccent}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Row="1" x:Name="lblEnunciado" FontFamily="{StaticResource FontHeading}" FontSize="22" FontWeight="Bold"
                           TextWrapping="Wrap" Margin="0,14,0,10"/>

                <!-- Respuesta: opciones (opción múltiple) o campo de texto (tipeo) -->
                <Grid Grid.Row="2">
                    <StackPanel x:Name="pnlOpciones"/>

                    <StackPanel x:Name="pnlTipeo" Visibility="Collapsed">
                        <TextBox x:Name="txtRespuesta" Style="{StaticResource RoundedTextBox}" FontSize="16" Height="46"
                                 AutomationProperties.Name="Escribí la palabra de la seña" TextChanged="TxtRespuesta_TextChanged"/>
                        <TextBlock Text="No importan las mayúsculas ni las tildes." FontSize="12.5"
                                   Foreground="{DynamicResource BrushMuted}" Margin="2,6,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Resultado de la respuesta: con símbolo y texto, no solo color. Se anuncia en lectores de pantalla. -->
                <Border Grid.Row="3" x:Name="pnlFeedback" Visibility="Collapsed" CornerRadius="12" BorderThickness="1.5"
                        Padding="14,10" Margin="0,10,0,0">
                    <TextBlock x:Name="lblFeedback" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Assertive"/>
                </Border>

                <Button Grid.Row="4" x:Name="btnConfirmar" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"
                        IsEnabled="False" Click="BtnConfirmar_Click">
                    <TextBlock x:Name="lblConfirmar" Text="Confirmar"/>
                </Button>
            </Grid>
        </Grid>

        <!-- ===== Resultado final ===== -->
        <Border x:Name="pnlResultado" Visibility="Collapsed" Background="{DynamicResource BrushCard}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1.5" CornerRadius="18" Padding="40"
                VerticalAlignment="Top">
            <StackPanel>
                <TextBlock x:Name="lblResultadoIcono" FontFamily="{StaticResource FontIconos}" FontSize="40"
                           Foreground="{DynamicResource BrushAccent}"/>
                <TextBlock x:Name="lblResultado" FontFamily="{StaticResource FontHeading}" FontSize="28" FontWeight="Bold"
                           Margin="0,12,0,0" AutomationProperties.LiveSetting="Assertive"/>
                <TextBlock x:Name="lblResultadoDetalle" FontSize="15" Foreground="{DynamicResource BrushMuted}"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                    <Button x:Name="btnPracticarDeNuevo" Style="{StaticResource PrimaryButton}" Width="220"
                            Click="BtnPracticarDeNuevo_Click" Content="Practicar de nuevo"/>
                    <Button Style="{StaticResource SecondaryButton}" Width="240" Margin="12,0,0,0"
                            Click="BtnOtraCategoria_Click" Content="Elegir otra categoría"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock x:Name="lblMensaje" Visibility="Collapsed" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Top"
                   Background="{DynamicResource BrushBackground}"/>
    </Grid>
</UserControl>
