<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- windows10.0.19041.0: da acceso al editor de video de Windows (Windows.Media.Editing), que usa
         el Traductor para exportar la traducción como MP4 sin programas externos. Requiere Windows 10 (2004) o 11. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.ico" />
    <Resource Include="Assets\logo.jpg" />
    <Resource Include="Assets\logo_alto_contraste.jpg" />
  </ItemGroup>

  <!-- Banco multimedia LSA: se copia junto al .exe (no va como Resource para no inflar el ejecutable) -->
  <ItemGroup>
    <None Remove="Assets\signs\**\*" />
    <None Remove="signs_database.json" />
    <Content Include="Assets\signs\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="signs_database.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

</Project>
