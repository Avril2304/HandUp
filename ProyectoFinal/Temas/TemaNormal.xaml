<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Paleta "asistente" (ivory + verde azulado).
         TemaAltoContraste.xaml tiene que definir exactamente las mismas claves:
         TemaVisual.Aplicar reemplaza un diccionario por el otro. -->

    <SolidColorBrush x:Key="BrushBackground" Color="#FAF8F4"/>
    <SolidColorBrush x:Key="BrushCard" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushBorder" Color="#E7E2D6"/>
    <SolidColorBrush x:Key="BrushBorderAccent" Color="#CFE8E1"/>
    <SolidColorBrush x:Key="BrushInk" Color="#14312B"/>
    <SolidColorBrush x:Key="BrushMuted" Color="#6B7B76"/>

    <SolidColorBrush x:Key="BrushAccent" Color="#1F7A6C"/>
    <SolidColorBrush x:Key="BrushAccentDark" Color="#175C52"/>
    <SolidColorBrush x:Key="BrushAccentSoft" Color="#EAF4F1"/>
    <!-- Texto e íconos sobre fondo de acento -->
    <SolidColorBrush x:Key="BrushOnAccent" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="BrushError" Color="#DC2626"/>
    <SolidColorBrush x:Key="BrushErrorBg" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="BrushSuccess" Color="#15803D"/>
    <SolidColorBrush x:Key="BrushSuccessBg" Color="#DCFCE7"/>

    <!-- Superficies oscuras: barra lateral, panel de marca y tile destacado -->
    <SolidColorBrush x:Key="BrushSidebar" Color="#14332B"/>
    <SolidColorBrush x:Key="BrushOnSidebar" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushSidebarMuted" Color="#9DBDB4"/>
    <SolidColorBrush x:Key="BrushSidebarSubtle" Color="#CFE8E1"/>
    <SolidColorBrush x:Key="BrushSidebarHover" Color="#22483F"/>
    <SolidColorBrush x:Key="BrushSidebarLine" Color="#3D6B60"/>
    <SolidColorBrush x:Key="BrushSidebarTrack" Color="#2A4D44"/>
    <SolidColorBrush x:Key="BrushSidebarHighlight" Color="#5DCAA5"/>
    <SolidColorBrush x:Key="BrushSidebarDanger" Color="#F7C1C1"/>
    <SolidColorBrush x:Key="BrushNavActive" Color="#1F7A6C"/>
    <SolidColorBrush x:Key="BrushHeroHover" Color="#175C52"/>

</ResourceDictionary>
