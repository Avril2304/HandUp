<UserControl x:Class="ProyectoFinal.ProximamenteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Pantalla genérica para las secciones que todavía no están implementadas -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="lblTitulo" Text="Sección" FontFamily="{StaticResource FontHeading}" FontSize="26"
                       FontWeight="Bold" Foreground="{StaticResource BrushInk}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" x:Name="btnVolver" Style="{StaticResource SecondaryButton}" Padding="16,0"
                    Click="BtnVolver_Click" AutomationProperties.Name="Volver al inicio" ToolTip="Volver al inicio (Esc)">
                <StackPanel Orientation="Horizontal" Margin="16,0">
                    <TextBlock Text="&#xE72B;" FontFamily="{StaticResource FontIconos}" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="Volver al inicio" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1.5"
                CornerRadius="18" Padding="40" VerticalAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="88" Height="88" CornerRadius="20" Background="{StaticResource BrushAccentSoft}" VerticalAlignment="Top">
                    <TextBlock x:Name="lblIcono" FontFamily="{StaticResource FontIconos}" FontSize="40"
                               Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE90F;" FontFamily="{StaticResource FontIconos}" FontSize="16"
                                   Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center"/>
                        <TextBlock Text="Próximamente" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushMuted}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Esta sección todavía está en construcción." FontFamily="{StaticResource FontHeading}"
                               FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushInk}" Margin="0,10,0,0"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="lblDescripcion" FontSize="14" Foreground="{StaticResource BrushMuted}"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
