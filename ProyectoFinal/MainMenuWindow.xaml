<Window x:Class="ProyectoFinal.MainMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ProyectoFinal"
        Title="HandUp — Menú principal"
        Height="650" Width="1000"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBackground}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Barra lateral: solo aparece dentro de una sección ===== -->
        <Border Grid.Column="0" x:Name="barraLateral" Width="220" Background="{StaticResource BrushSidebar}"
                Padding="14,20" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Marca -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,0,0,0">
                    <Border Width="34" Height="34" CornerRadius="9" ClipToBounds="True">
                        <Border.Background>
                            <ImageBrush ImageSource="Assets/logo.jpg" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <TextBlock Text="HandUp" FontFamily="{StaticResource FontHeading}" FontSize="20" FontWeight="Bold"
                               Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Usuario y racha -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="6,12,0,18">
                    <TextBlock x:Name="lblUsuarioLateral" Text="Usuario" FontSize="12.5" Foreground="{StaticResource BrushSidebarMuted}"/>
                    <TextBlock Text=" · " FontSize="12.5" Foreground="{StaticResource BrushSidebarMuted}"/>
                    <TextBlock Text="&#xE945;" FontFamily="{StaticResource FontIconos}" FontSize="12"
                               Foreground="{StaticResource BrushSidebarMuted}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblRachaLateral" Text="0" FontSize="12.5" Foreground="{StaticResource BrushSidebarMuted}" Margin="3,0,0,0"/>
                </StackPanel>

                <!-- Secciones principales -->
                <StackPanel Grid.Row="2">
                    <Button x:Name="navInicio" Style="{StaticResource NavItem}" Click="Nav_Click"
                            CommandParameter="{x:Static local:Seccion.Inicio}" AutomationProperties.Name="Inicio">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE80F;" FontFamily="{StaticResource FontIconos}" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Inicio" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Esc" FontSize="11" Foreground="{StaticResource BrushSidebarMuted}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button x:Name="navAprender" Style="{StaticResource NavItem}" Click="Nav_Click"
                            CommandParameter="{x:Static local:Seccion.Aprender}" AutomationProperties.Name="Aprender">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7BE;" FontFamily="{StaticResource FontIconos}" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Aprender" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Ctrl+1" FontSize="11" Foreground="{StaticResource BrushSidebarMuted}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button x:Name="navDesafio" Style="{StaticResource NavItem}" Click="Nav_Click"
                            CommandParameter="{x:Static local:Seccion.Desafio}" AutomationProperties.Name="Desafío">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE916;" FontFamily="{StaticResource FontIconos}" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Desafío" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Ctrl+2" FontSize="11" Foreground="{StaticResource BrushSidebarMuted}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button x:Name="navTraductor" Style="{StaticResource NavItem}" Click="Nav_Click"
                            CommandParameter="{x:Static local:Seccion.Traductor}" AutomationProperties.Name="Traductor">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8C1;" FontFamily="{StaticResource FontIconos}" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Traductor" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Ctrl+3" FontSize="11" Foreground="{StaticResource BrushSidebarMuted}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button x:Name="navDiccionario" Style="{StaticResource NavItem}" Click="Nav_Click"
                            CommandParameter="{x:Static local:Seccion.Diccionario}" AutomationProperties.Name="Diccionario">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE82D;" FontFamily="{StaticResource FontIconos}" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Diccionario" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Ctrl+4" FontSize="11" Foreground="{StaticResource BrushSidebarMuted}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Perfil y salir, abajo de todo -->
                <StackPanel Grid.Row="4">
                    <Button x:Name="navPerfil" Style="{StaticResource NavItem}" Click="Nav_Click"
                            CommandParameter="{x:Static local:Seccion.MiPerfil}" AutomationProperties.Name="Mi perfil">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE77B;" FontFamily="{StaticResource FontIconos}" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Mi perfil" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Ctrl+5" FontSize="11" Foreground="{StaticResource BrushSidebarMuted}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button x:Name="navSalir" Style="{StaticResource NavItem}" Click="Salir_Click" AutomationProperties.Name="Salir de HandUp">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xF3B1;" FontFamily="{StaticResource FontIconos}" FontSize="16" Foreground="#F7C1C1" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Salir" Foreground="#F7C1C1" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Contenido ===== -->
        <Grid Grid.Column="1" Margin="44,30,44,28">

            <!-- Inicio: tiles grandes -->
            <Grid x:Name="panelInicio">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Encabezado: saludo + racha + nivel -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="lblSaludo" Text="¡Hola!" FontFamily="{StaticResource FontHeading}"
                               FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrushInk}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Border x:Name="borderRacha" Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                CornerRadius="20" Padding="14,7" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE945;" FontFamily="{StaticResource FontIconos}" FontSize="13"
                                           Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblRacha" Text="Racha 0" FontWeight="Bold" FontSize="13"
                                           Foreground="{StaticResource BrushInk}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource BrushAccent}" CornerRadius="20" Padding="14,7">
                            <TextBlock x:Name="lblNivel" Text="Nivel" Foreground="White" FontWeight="Bold" FontSize="13"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Grilla de opciones: Aprender destacado + el resto -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 1. Aprender (destacado) -->
                    <Button Grid.Column="0" Grid.RowSpan="3" x:Name="tileAprender" Style="{StaticResource MenuTileHero}"
                            Click="Nav_Click" CommandParameter="{x:Static local:Seccion.Aprender}" Padding="24"
                            AutomationProperties.Name="Aprender. Atajo: tecla 1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Width="56" Height="56" CornerRadius="14" Background="{StaticResource BrushAccent}" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE7BE;" FontFamily="{StaticResource FontIconos}" FontSize="28" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Row="0" Style="{StaticResource AtajoBadge}" BorderBrush="#3D6B60">
                                <TextBlock Text="1" FontSize="12" FontWeight="Bold" Foreground="#CFE8E1"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="Aprender" FontFamily="{StaticResource FontHeading}" FontSize="28"
                                       FontWeight="Bold" Margin="0,16,0,0"/>
                            <TextBlock Grid.Row="2" Text="Elegí un nivel y una categoría, y practicá seña por seña."
                                       FontSize="13.5" Foreground="#CFE8E1" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="4" x:Name="lblProgresoNivel" Text="0 / 0 señas del nivel" FontSize="12.5" Foreground="#CFE8E1"/>
                            <!-- Barra de progreso: dos columnas proporcionales (lleno / vacío) -->
                            <Border Grid.Row="5" Height="10" CornerRadius="5" Background="#2A4D44" Margin="0,6,0,0" ClipToBounds="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="colProgresoLleno" Width="0*"/>
                                        <ColumnDefinition x:Name="colProgresoVacio" Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="5" Background="#5DCAA5"/>
                                </Grid>
                            </Border>
                            <Border Grid.Row="6" Background="{StaticResource BrushAccent}" CornerRadius="10" Height="42" Margin="0,18,0,0">
                                <TextBlock Text="Empezar  →" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>

                    <!-- 2. Desafío -->
                    <Button Grid.Column="2" Grid.Row="0" x:Name="tileDesafio" Style="{StaticResource MenuTile}"
                            Click="Nav_Click" CommandParameter="{x:Static local:Seccion.Desafio}"
                            AutomationProperties.Name="Desafío. Atajo: tecla 2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource BrushAccentSoft}" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE916;" FontFamily="{StaticResource FontIconos}" FontSize="24" Foreground="{StaticResource BrushAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Style="{StaticResource AtajoBadge}">
                                <TextBlock Text="2" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushAccentDark}"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="Desafío" FontFamily="{StaticResource FontHeading}" FontSize="20" FontWeight="Bold" Margin="0,12,0,0"/>
                            <TextBlock Grid.Row="2" x:Name="lblMejorRacha" Text="Contrarreloj con vidas" FontSize="12.5"
                                       Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </Grid>
                    </Button>

                    <!-- 3. Traductor -->
                    <Button Grid.Column="4" Grid.Row="0" x:Name="tileTraductor" Style="{StaticResource MenuTile}"
                            Click="Nav_Click" CommandParameter="{x:Static local:Seccion.Traductor}"
                            AutomationProperties.Name="Traductor. Atajo: tecla 3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource BrushAccentSoft}" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE8C1;" FontFamily="{StaticResource FontIconos}" FontSize="24" Foreground="{StaticResource BrushAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Style="{StaticResource AtajoBadge}">
                                <TextBlock Text="3" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushAccentDark}"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="Traductor" FontFamily="{StaticResource FontHeading}" FontSize="20" FontWeight="Bold" Margin="0,12,0,0"/>
                            <TextBlock Grid.Row="2" Text="De texto a señas" FontSize="12.5"
                                       Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </Grid>
                    </Button>

                    <!-- 4. Diccionario -->
                    <Button Grid.Column="2" Grid.Row="2" x:Name="tileDiccionario" Style="{StaticResource MenuTile}"
                            Click="Nav_Click" CommandParameter="{x:Static local:Seccion.Diccionario}"
                            AutomationProperties.Name="Diccionario. Atajo: tecla 4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource BrushAccentSoft}" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE82D;" FontFamily="{StaticResource FontIconos}" FontSize="24" Foreground="{StaticResource BrushAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Style="{StaticResource AtajoBadge}">
                                <TextBlock Text="4" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushAccentDark}"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="Diccionario" FontFamily="{StaticResource FontHeading}" FontSize="20" FontWeight="Bold" Margin="0,12,0,0"/>
                            <TextBlock Grid.Row="2" x:Name="lblCantidadSenas" Text="Buscá cualquier seña" FontSize="12.5"
                                       Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </Grid>
                    </Button>

                    <!-- 5. Mi perfil y Salir, más chicos -->
                    <Grid Grid.Column="4" Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" x:Name="tilePerfil" Style="{StaticResource MenuTile}" Padding="18,0"
                                Click="Nav_Click" CommandParameter="{x:Static local:Seccion.MiPerfil}"
                                AutomationProperties.Name="Mi perfil. Atajo: tecla 5">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE77B;" FontFamily="{StaticResource FontIconos}" FontSize="22" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Mi perfil" FontSize="15" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Style="{StaticResource AtajoBadge}" VerticalAlignment="Center">
                                    <TextBlock Text="5" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushAccentDark}"/>
                                </Border>
                            </Grid>
                        </Button>
                        <Button Grid.Row="2" x:Name="tileSalir" Style="{StaticResource MenuTile}" Padding="18,0"
                                Click="Salir_Click" AutomationProperties.Name="Salir de HandUp. Atajo: Escape">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xF3B1;" FontFamily="{StaticResource FontIconos}" FontSize="22" Foreground="{StaticResource BrushError}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Salir" FontSize="15" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Style="{StaticResource AtajoBadge}" VerticalAlignment="Center">
                                    <TextBlock Text="Esc" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushAccentDark}"/>
                                </Border>
                            </Grid>
                        </Button>
                    </Grid>
                </Grid>

                <TextBlock Grid.Row="4" Text="Usá Tab y Enter para moverte, o las teclas 1 a 5 para entrar directo."
                           FontSize="12.5" Foreground="{StaticResource BrushMuted}" HorizontalAlignment="Center"/>
            </Grid>

            <!-- Sección: acá se carga la vista de cada módulo (por ahora, "Próximamente") -->
            <ContentControl x:Name="contenidoSeccion" Visibility="Collapsed" Focusable="False"/>
        </Grid>
    </Grid>
</Window>
