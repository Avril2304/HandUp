<UserControl x:Class="ProyectoFinal.CertificadoVisual"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="1123" Height="794" FontFamily="Segoe UI">
    <!-- Certificado de HandUp (A4 horizontal a 96 ppp). Es un documento: usa siempre los colores de la app,
         aunque el perfil tenga alto contraste. A la izquierda, el panel de marca del inicio de sesión. -->
    <Grid Background="#FAF8F4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Panel de marca ===== -->
        <Grid Background="#14332B">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="150" Height="150" CornerRadius="34" ClipToBounds="True" HorizontalAlignment="Center">
                    <Border.Background>
                        <ImageBrush ImageSource="Assets/logo.jpg" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
                <TextBlock Text="HandUp" FontFamily="{StaticResource FontHeading}" FontSize="44" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center" Margin="0,22,0,0"/>
                <Border Width="56" Height="4" CornerRadius="2" Background="#5DCAA5" Margin="0,16,0,0"/>
                <TextBlock Text="Lengua de Señas Argentina" FontSize="15" Foreground="#CFE8E1"
                           HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>
            <TextBlock Text="Aprendé LSA, seña por seña" FontSize="12.5" Foreground="#9DBDB4"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,38"/>
        </Grid>

        <!-- ===== Certificado ===== -->
        <Border Grid.Column="1" Margin="34" BorderBrush="#CFE8E1" BorderThickness="2" CornerRadius="10">
            <Grid Margin="56,44,56,36">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="CERTIFICADO DE FINALIZACIÓN" FontSize="17" FontWeight="Bold" Foreground="#1F7A6C"/>
                    <Border Width="70" Height="4" CornerRadius="2" Background="#5DCAA5" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="Se otorga a" FontSize="19" Foreground="#6B7B76"/>
                    <TextBlock x:Name="lblNombre" FontFamily="{StaticResource FontHeading}" FontSize="50" FontWeight="Bold"
                               Foreground="#14312B" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <Border Height="2" Background="#E7E2D6" Margin="0,14,0,0" HorizontalAlignment="Left" Width="520"/>
                    <TextBlock x:Name="lblDetalle" FontSize="18" Foreground="#14312B" TextWrapping="Wrap" LineHeight="28"
                               Margin="0,20,0,0" MaxWidth="600" HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- Fecha, sello y número -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock x:Name="lblFecha" FontSize="17" FontWeight="SemiBold" Foreground="#14312B"/>
                        <Border Height="1.5" Background="#14312B" Width="200" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                        <TextBlock Text="FECHA" FontSize="11.5" FontWeight="Bold" Foreground="#6B7B76" Margin="0,6,0,0"/>
                    </StackPanel>

                    <Grid Grid.Column="1" Width="124" Height="124">
                        <Ellipse Stroke="#1F7A6C" StrokeThickness="4"/>
                        <Ellipse Margin="9" Fill="#EAF4F1" Stroke="#5DCAA5" StrokeThickness="1.5"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE735;" FontFamily="{StaticResource FontIconos}" FontSize="36" Foreground="#1F7A6C"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="HANDUP" FontSize="12" FontWeight="Bold" Foreground="#175C52" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            <TextBlock Text="COMPLETO" FontSize="9.5" FontWeight="Bold" Foreground="#6B7B76" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                        <TextBlock x:Name="lblCodigo" FontSize="17" FontWeight="SemiBold" Foreground="#14312B" HorizontalAlignment="Right"/>
                        <Border Height="1.5" Background="#14312B" Width="200" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                        <TextBlock Text="N.º DE CERTIFICADO" FontSize="11.5" FontWeight="Bold" Foreground="#6B7B76"
                                   HorizontalAlignment="Right" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
