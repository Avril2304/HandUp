<UserControl x:Class="ProyectoFinal.ElegirCategoriaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="Vista_PreviewKeyDown">
    <!-- Paso 2 de Aprender: las categorías del nivel elegido, en una grilla de 3 columnas. Teclas 1-9 para elegir. -->
    <Grid>
        <!-- El margen negativo compensa el espacio que deja cada tarjeta a su derecha y abajo -->
        <ItemsControl x:Name="lstCategorias" Focusable="False" Margin="0,0,-12,-12">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" VerticalAlignment="Top"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource MenuTile}" Margin="0,0,12,12" Padding="18,14" Height="150"
                            Click="Categoria_Click" AutomationProperties.Name="{Binding NombreAccesible}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding Emoji}" FontFamily="Segoe UI Emoji" FontSize="20" LineHeight="26" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Left"/>
                            <Border Style="{StaticResource AtajoBadge}">
                                <TextBlock Text="{Binding Atajo}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushAccentDark}"/>
                            </Border>

                            <TextBlock Grid.Row="1" Text="{Binding Nombre}" FontSize="15.5" FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="2" Text="{Binding Descripcion}" FontSize="12.5" TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource BrushMuted}" Margin="0,2,0,0"/>
                            <TextBlock Grid.Row="3" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}">
                                <Run Text="{Binding Cantidad, Mode=OneWay}"/><Run Text="{Binding TextoSenas, Mode=OneWay}"/>
                            </TextBlock>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Si la base no responde o el nivel no tiene categorías, se muestra esto en lugar de la grilla -->
        <TextBlock x:Name="lblMensaje" Visibility="Collapsed" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Top"/>
    </Grid>
</UserControl>
