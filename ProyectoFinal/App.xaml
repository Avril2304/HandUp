<Application x:Class="ProyectoFinal.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Colores: viven en un diccionario aparte para poder cambiar de tema (TemaVisual.Aplicar).
                 No definir brushes acá: los de este diccionario le ganan a los del tema y el alto contraste no se vería.
                 En las vistas, los colores se usan siempre con {DynamicResource Brush...}. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Temas/TemaNormal.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="FontHeading">Georgia</FontFamily>

            <DropShadowEffect x:Key="CardShadow" Color="#14312B" Opacity="0.10" BlurRadius="24" ShadowDepth="6" Direction="270"/>

            <!-- Etiqueta de campo -->
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>

            <!-- TextBox redondeado -->
            <Style x:Key="RoundedTextBox" TargetType="TextBox">
                <Setter Property="Height" Value="40"/>
                <Setter Property="Padding" Value="12,0,12,0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="Background" Value="{DynamicResource BrushCard}"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource BrushInk}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- PasswordBox redondeado -->
            <Style x:Key="RoundedPasswordBox" TargetType="PasswordBox">
                <Setter Property="Height" Value="40"/>
                <Setter Property="Padding" Value="12,0,12,0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="Background" Value="{DynamicResource BrushCard}"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource BrushInk}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Botón primario (relleno, verde azulado) -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource BrushAccentDark}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bg" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Botón secundario (contorno) -->
            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BrushBorderAccent}" BorderThickness="1.5" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Botón tipo link (ej. "¿No tenés cuenta?") -->
            <Style x:Key="LinkButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushAccent}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Chip de perfil (reemplaza la lista de "perfiles existentes") -->
            <Style x:Key="ProfileChipItem" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,0,10,10"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="chip" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1.5" CornerRadius="14" Padding="16,10"
                                    TextElement.Foreground="{DynamicResource BrushInk}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="chip" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="chip" Property="Background" Value="{DynamicResource BrushAccent}"/>
                                    <Setter TargetName="chip" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                    <Setter TargetName="chip" Property="TextElement.Foreground" Value="{DynamicResource BrushOnAccent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Chip "Ver más": mismo tamaño que un chip de perfil, pero en tono de acento para diferenciarse -->
            <Style x:Key="MoreChipButton" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource BrushAccent}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="chip" Background="{DynamicResource BrushAccentSoft}" BorderBrush="{DynamicResource BrushBorderAccent}"
                                    BorderThickness="1.5" CornerRadius="14" Padding="16,10">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="chip" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="chip" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Fila de perfil para el listado completo (ventana "Ver más") -->
            <Style x:Key="ProfileRowItem" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="fila" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1.5" CornerRadius="12" Padding="12,10"
                                    TextElement.Foreground="{DynamicResource BrushInk}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="fila" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="fila" Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
                                    <Setter TargetName="fila" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Menú principal ===== -->

            <!-- Fuente de íconos del sistema (Windows 11; en Windows 10 cae a MDL2, que comparte los glifos) -->
            <FontFamily x:Key="FontIconos">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <!-- Tile del inicio: tarjeta blanca clickeable y enfocable con Tab -->
            <Style x:Key="MenuTile" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource BrushCard}"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="20"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1.5" CornerRadius="18" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                </Trigger>
                                <!-- Foco de teclado bien visible (no depende solo del color: el borde se engrosa) -->
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                    <Setter TargetName="bg" Property="BorderThickness" Value="3"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Tile destacado (Aprender): fondo verde oscuro, mismo comportamiento -->
            <Style x:Key="MenuTileHero" TargetType="Button" BasedOn="{StaticResource MenuTile}">
                <Setter Property="Background" Value="{DynamicResource BrushSidebar}"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushOnSidebar}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrushHeroBorder}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1.5" CornerRadius="18" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource BrushHeroHover}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource BrushSidebarHighlight}"/>
                                    <Setter TargetName="bg" Property="BorderThickness" Value="3"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Interruptor (CheckBox con forma de switch): la pista a la izquierda y el texto a la derecha.
                 Se activa con clic o con Espacio; con el foco de teclado aparece un borde alrededor de la pista. -->
            <Style x:Key="SwitchToggle" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="foco" BorderBrush="Transparent" BorderThickness="2" CornerRadius="15" Padding="2"
                                        VerticalAlignment="Center">
                                    <Border x:Name="pista" Width="44" Height="24" CornerRadius="12" Background="{DynamicResource BrushMuted}">
                                        <Ellipse x:Name="perilla" Width="18" Height="18" Margin="3,0" HorizontalAlignment="Left"
                                                 Fill="{DynamicResource BrushCard}"/>
                                    </Border>
                                </Border>
                                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="pista" Property="Background" Value="{DynamicResource BrushAccent}"/>
                                    <Setter TargetName="perilla" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="perilla" Property="Fill" Value="{DynamicResource BrushOnAccent}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="foco" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Recuadro del atajo de teclado ("1", "Esc") en la esquina de cada tile -->
            <Style x:Key="AtajoBadge" TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderAccent}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="Padding" Value="6,1"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
            </Style>

            <!-- Ítem de la barra lateral. Tag="activo" marca la sección en la que estás -->
            <Style x:Key="NavItem" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource BrushOnSidebar}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Height" Value="42"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                                    BorderThickness="2" CornerRadius="10" Padding="12,0">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource BrushSidebarHover}"/>
                                </Trigger>
                                <Trigger Property="Tag" Value="activo">
                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource BrushNavActive}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource BrushSidebarHighlight}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
