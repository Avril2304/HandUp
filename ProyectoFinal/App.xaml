<Application x:Class="ProyectoFinal.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Paleta "asistente" (ivory + verde azulado) -->
            <FontFamily x:Key="FontHeading">Georgia</FontFamily>

            <SolidColorBrush x:Key="BrushBackground" Color="#FAF8F4"/>
            <SolidColorBrush x:Key="BrushCard" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="BrushBorder" Color="#E7E2D6"/>
            <SolidColorBrush x:Key="BrushBorderAccent" Color="#CFE8E1"/>
            <SolidColorBrush x:Key="BrushInk" Color="#14312B"/>
            <SolidColorBrush x:Key="BrushMuted" Color="#6B7B76"/>

            <SolidColorBrush x:Key="BrushAccent" Color="#1F7A6C"/>
            <SolidColorBrush x:Key="BrushAccentDark" Color="#175C52"/>
            <SolidColorBrush x:Key="BrushAccentSoft" Color="#EAF4F1"/>

            <SolidColorBrush x:Key="BrushError" Color="#DC2626"/>
            <SolidColorBrush x:Key="BrushErrorBg" Color="#FEE2E2"/>
            <SolidColorBrush x:Key="BrushSuccess" Color="#15803D"/>
            <SolidColorBrush x:Key="BrushSuccessBg" Color="#DCFCE7"/>

            <DropShadowEffect x:Key="CardShadow" Color="#14312B" Opacity="0.10" BlurRadius="24" ShadowDepth="6" Direction="270"/>

            <!-- Etiqueta de campo -->
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource BrushInk}"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>

            <!-- TextBox redondeado -->
            <Style x:Key="RoundedTextBox" TargetType="TextBox">
                <Setter Property="Height" Value="40"/>
                <Setter Property="Padding" Value="12,0,12,0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- PasswordBox redondeado -->
            <Style x:Key="RoundedPasswordBox" TargetType="PasswordBox">
                <Setter Property="Height" Value="40"/>
                <Setter Property="Padding" Value="12,0,12,0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Botón primario (relleno, verde azulado) -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="{StaticResource BrushAccentDark}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bg" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Botón secundario (contorno) -->
            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource BrushInk}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{StaticResource BrushBorderAccent}" BorderThickness="1.5" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="{StaticResource BrushAccentSoft}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Botón tipo link (ej. "¿No tenés cuenta?") -->
            <Style x:Key="LinkButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Chip de perfil (reemplaza la lista de "perfiles existentes") -->
            <Style x:Key="ProfileChipItem" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,0,10,10"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="chip" Background="White" BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1.5" CornerRadius="14" Padding="16,10"
                                    TextElement.Foreground="{StaticResource BrushInk}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="chip" Property="Background" Value="{StaticResource BrushAccent}"/>
                                    <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                    <Setter TargetName="chip" Property="TextElement.Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Chip "Ver más": mismo tamaño que un chip de perfil, pero en tono de acento para diferenciarse -->
            <Style x:Key="MoreChipButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="chip" Background="{StaticResource BrushAccentSoft}" BorderBrush="{StaticResource BrushBorderAccent}"
                                    BorderThickness="1.5" CornerRadius="14" Padding="16,10">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Fila de perfil para el listado completo (ventana "Ver más") -->
            <Style x:Key="ProfileRowItem" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="fila" Background="White" BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1.5" CornerRadius="12" Padding="12,10"
                                    TextElement.Foreground="{StaticResource BrushInk}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="fila" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="fila" Property="Background" Value="{StaticResource BrushAccentSoft}"/>
                                    <Setter TargetName="fila" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Menú principal ===== -->

            <!-- Fuente de íconos del sistema (Windows 11; en Windows 10 cae a MDL2, que comparte los glifos) -->
            <FontFamily x:Key="FontIconos">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
            <SolidColorBrush x:Key="BrushSidebar" Color="#14332B"/>
            <SolidColorBrush x:Key="BrushSidebarMuted" Color="#9DBDB4"/>

            <!-- Tile del inicio: tarjeta blanca clickeable y enfocable con Tab -->
            <Style x:Key="MenuTile" TargetType="Button">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="{StaticResource BrushInk}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="20"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1.5" CornerRadius="18" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                </Trigger>
                                <!-- Foco de teclado bien visible (no depende solo del color: el borde se engrosa) -->
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                    <Setter TargetName="bg" Property="BorderThickness" Value="3"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="{StaticResource BrushAccentSoft}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Tile destacado (Aprender): fondo verde oscuro, mismo comportamiento -->
            <Style x:Key="MenuTileHero" TargetType="Button" BasedOn="{StaticResource MenuTile}">
                <Setter Property="Background" Value="{StaticResource BrushSidebar}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushSidebar}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1.5" CornerRadius="18" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="{StaticResource BrushAccentDark}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="bg" Property="BorderBrush" Value="#5DCAA5"/>
                                    <Setter TargetName="bg" Property="BorderThickness" Value="3"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Recuadro del atajo de teclado ("1", "Esc") en la esquina de cada tile -->
            <Style x:Key="AtajoBadge" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorderAccent}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="Padding" Value="6,1"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
            </Style>

            <!-- Ítem de la barra lateral. Tag="activo" marca la sección en la que estás -->
            <Style x:Key="NavItem" TargetType="Button">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Height" Value="42"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                                    BorderThickness="2" CornerRadius="10" Padding="12,0">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#22483F"/>
                                </Trigger>
                                <Trigger Property="Tag" Value="activo">
                                    <Setter TargetName="bg" Property="Background" Value="{StaticResource BrushAccent}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="bg" Property="BorderBrush" Value="#5DCAA5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
