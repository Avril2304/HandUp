<Window x:Class="ProyectoFinal.FelicitacionesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HandUp — ¡Felicitaciones!" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/logo.ico"
        Background="{DynamicResource BrushCard}" FontFamily="Segoe UI" Loaded="Window_Loaded">
    <!-- Se abre la primera vez que se aprueba el examen final de HandUp (y desde "Ver mi certificado").
         Felicita, muestra el certificado y deja guardarlo como PDF o PNG. Escape o Cerrar la cierran. -->
    <StackPanel>
        <!-- Encabezado con los colores del panel de marca -->
        <Border Background="{DynamicResource BrushSidebar}" Padding="30,26">
            <StackPanel>
                <TextBlock Text="&#xE735;" FontFamily="{StaticResource FontIconos}" FontSize="38"
                           Foreground="{DynamicResource BrushSidebarHighlight}"/>
                <TextBlock x:Name="lblTitulo" FontFamily="{StaticResource FontHeading}" FontSize="28" FontWeight="Bold"
                           Foreground="{DynamicResource BrushOnSidebar}" TextWrapping="Wrap" Margin="0,10,0,0"
                           AutomationProperties.LiveSetting="Assertive"/>
                <TextBlock Text="Completaste HandUp" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushSidebarSubtle}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Margin="30,22,30,26">
            <TextBlock x:Name="lblDetalle" FontSize="14.5" Foreground="{DynamicResource BrushInk}" TextWrapping="Wrap" LineHeight="21"/>

            <!-- Vista previa del certificado -->
            <Border Margin="0,18,0,0" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1.5" CornerRadius="10"
                    ClipToBounds="True">
                <Image x:Name="imgCertificado" Stretch="Uniform"/>
            </Border>

            <TextBlock x:Name="lblEstado" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,0"
                       Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"/>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>
                <!-- IsCancel: Escape cierra -->
                <Button x:Name="btnCerrar" Style="{StaticResource SecondaryButton}" Content="Cerrar" IsCancel="True"/>
                <Button Grid.Column="2" x:Name="btnAbrir" Style="{StaticResource SecondaryButton}" Content="Abrir archivo"
                        IsEnabled="False" Click="BtnAbrir_Click"/>
                <Button Grid.Column="4" x:Name="btnDescargar" Style="{StaticResource PrimaryButton}" Click="BtnDescargar_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource FontIconos}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Descargar certificado" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </StackPanel>
</Window>
