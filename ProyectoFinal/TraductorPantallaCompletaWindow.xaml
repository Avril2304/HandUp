<Window x:Class="ProyectoFinal.TraductorPantallaCompletaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ProyectoFinal"
        Title="HandUp - Traductor en pantalla completa"
        WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#101010" PreviewKeyDown="Window_PreviewKeyDown" Loaded="Window_Loaded">
    <!-- Traductor en pantalla completa: la seña grande a la izquierda y, al lado, qué palabra se está haciendo,
         la frase completa y el avance. La secuencia la sigue manejando TraductorView. -->
    <Window.Resources>
        <!-- Botón claro sobre fondo oscuro (los estilos de la app son para fondo claro) -->
        <Style x:Key="BotonOscuro" TargetType="Button">
            <Setter Property="Foreground" Value="#F1EFE8"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" BorderBrush="#5F5E5A" BorderThickness="1.5"
                                CornerRadius="10" Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2C2C2A"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="bg" Property="BorderThickness" Value="2.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="32,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="28"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- Seña grande y controles de la secuencia -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <local:VisorSena x:Name="visor"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <Button x:Name="btnPausar" Style="{StaticResource BotonOscuro}" Click="BtnPausar_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="icoPausar" Text="&#xE769;" FontFamily="{StaticResource FontIconos}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblPausar" Text="Pausar" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="btnRepetir" Style="{StaticResource BotonOscuro}" Click="BtnRepetir_Click"
                        AutomationProperties.Name="Repetir la traducción desde el principio" ToolTip="Repetir (R)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource FontIconos}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Repetir" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="btnLento" Style="{StaticResource BotonOscuro}" Click="BtnLento_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEC4A;" FontFamily="{StaticResource FontIconos}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblLento" Text="Más lento" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Panel lateral: qué se está haciendo ahora y la frase completa -->
        <Border Grid.Column="2" BorderBrush="#444441" BorderThickness="1.5,0,0,0" Padding="28,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="AHORA" FontSize="12.5" FontWeight="Bold" Foreground="#888780"/>
                    <TextBlock x:Name="lblAhora" FontFamily="{StaticResource FontHeading}" FontSize="52" FontWeight="Bold"
                               Foreground="#F1EFE8" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock x:Name="lblDetalle" FontSize="15" Foreground="#B4B2A9" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,32,0,0">
                    <TextBlock Text="FRASE" FontSize="12.5" FontWeight="Bold" Foreground="#888780"/>
                    <WrapPanel x:Name="pnlFrase" Margin="0,10,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock x:Name="lblAvance" FontSize="12.5" FontWeight="Bold" Foreground="#888780"/>
                    <Border Height="6" CornerRadius="3" Margin="0,8,0,0" Background="#444441" ClipToBounds="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="colAvanceLleno" Width="0*"/>
                                <ColumnDefinition x:Name="colAvanceVacio" Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="3" Background="#1D9E75"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="lblAtajos" FontSize="12.5" Foreground="#888780" Margin="0,14,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
