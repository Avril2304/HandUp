<UserControl x:Class="ProyectoFinal.PerfilView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Mi perfil: datos del usuario, avance en su nivel y estadísticas. Solo lectura;
         se actualiza sola cuando ServicioProgreso avisa que cambió el progreso. -->
    <UserControl.Resources>
        <!-- Dato que se puede recorrer con Tab: el lector de pantalla lee su AutomationProperties.Name
             (ej. "Mejor racha: 12"). Con el foco de teclado el borde se engrosa y toma el color de acento. -->
        <Style x:Key="DatoEnfocable" TargetType="Label">
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="IsTabStop" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Label">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.5" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter RecognizesAccessKey="False"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                <Setter TargetName="bg" Property="BorderThickness" Value="3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tarjeta de cada estadística (las arma el código) -->
        <Style x:Key="TarjetaEstadistica" TargetType="Label" BasedOn="{StaticResource DatoEnfocable}">
            <Setter Property="Background" Value="{DynamicResource BrushBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="6"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Mi perfil" FontFamily="{StaticResource FontHeading}" FontSize="26"
                       FontWeight="Bold" Foreground="{DynamicResource BrushInk}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="16,0"
                    Click="BtnVolver_Click" AutomationProperties.Name="Volver al inicio" ToolTip="Volver al inicio (Esc)">
                <StackPanel Orientation="Horizontal" Margin="16,0">
                    <TextBlock Text="&#xE72B;" FontFamily="{StaticResource FontIconos}" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="Volver al inicio" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="2" x:Name="scroll" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,6,0">
            <StackPanel>

                <!-- Aviso si no se pudieron leer los datos guardados. Se anuncia en lectores de pantalla. -->
                <Border x:Name="bordeAviso" Background="{DynamicResource BrushErrorBg}" BorderBrush="{DynamicResource BrushError}"
                        BorderThickness="1.5" CornerRadius="12" Padding="16,12" Margin="0,0,0,16" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource FontIconos}" FontSize="16"
                                   Foreground="{DynamicResource BrushError}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                        <TextBlock Grid.Column="1" x:Name="lblAviso" FontSize="13" Foreground="{DynamicResource BrushInk}"
                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
                    </Grid>
                </Border>

                <!-- Tarjeta: datos y nivel -->
                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1.5"
                        CornerRadius="18" Padding="26,18">
                    <StackPanel>
                        <Label x:Name="datoIdentidad" Style="{StaticResource DatoEnfocable}" Padding="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Avatar con la inicial -->
                                <Border Width="60" Height="60" CornerRadius="30" Background="{DynamicResource BrushAccent}">
                                    <TextBlock x:Name="lblInicial" Text="?" FontFamily="{StaticResource FontHeading}" FontSize="26"
                                               FontWeight="Bold" Foreground="{DynamicResource BrushOnAccent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="lblNombre" FontFamily="{StaticResource FontHeading}" FontSize="22" FontWeight="Bold"
                                               Foreground="{DynamicResource BrushInk}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="lblDetalleCuenta" FontSize="13" Foreground="{DynamicResource BrushMuted}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" Background="{DynamicResource BrushAccent}" CornerRadius="20" Padding="14,7"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Nivel " FontSize="13" Foreground="{DynamicResource BrushOnAccent}"/>
                                        <TextBlock x:Name="lblNivel" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushOnAccent}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Label>

                        <Label x:Name="datoProgresoNivel" Style="{StaticResource DatoEnfocable}" Padding="6" Margin="0,8,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="lblTituloProgreso" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource BrushInk}"/>
                                    <TextBlock Grid.Column="1" x:Name="lblCuentaProgreso" FontSize="13" Foreground="{DynamicResource BrushMuted}"/>
                                </Grid>
                                <!-- Barra de progreso: dos columnas proporcionales (lleno / vacío), igual que en el inicio -->
                                <Border Height="10" CornerRadius="5" Background="{DynamicResource BrushAccentSoft}"
                                        BorderBrush="{DynamicResource BrushBorderAccent}" BorderThickness="1" Margin="0,8,0,0" ClipToBounds="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="colProgresoLleno" Width="0*"/>
                                            <ColumnDefinition x:Name="colProgresoVacio" Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="5" Background="{DynamicResource BrushAccent}"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="lblSiguienteNivel" FontSize="12.5" Foreground="{DynamicResource BrushMuted}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Label>

                        <!-- Nivelación pendiente: eligió un nivel más alto al registrarse y todavía no rindió (o no aprobó) la prueba -->
                        <Border x:Name="pnlNivelacion" Visibility="Collapsed" CornerRadius="12" Padding="16,12" Margin="0,12,0,0"
                                Background="{DynamicResource BrushAccentSoft}" BorderBrush="{DynamicResource BrushBorderAccent}" BorderThickness="1.5">
                            <StackPanel>
                                <TextBlock x:Name="lblNivelacion" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"
                                           Foreground="{DynamicResource BrushInk}"/>
                                <TextBlock x:Name="lblNivelacionDetalle" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{DynamicResource BrushMuted}"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="btnRendirNivelacion" Style="{StaticResource PrimaryButton}" Height="40" Margin="0,0,10,0"
                                            Click="BtnRendirNivelacion_Click">
                                        <TextBlock Text="Rendir nivelación" Margin="16,0"/>
                                    </Button>
                                    <Button x:Name="btnDescartarNivelacion" Style="{StaticResource SecondaryButton}" Height="40"
                                            Click="BtnDescartarNivelacion_Click">
                                        <TextBlock Text="Empezar como Principiante" Margin="16,0"/>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Tarjeta: estadísticas -->
                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1.5"
                        CornerRadius="18" Padding="26,18" Margin="0,12,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource FontIconos}" FontSize="16"
                                       Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center"/>
                            <TextBlock Text="ESTADÍSTICAS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushMuted}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Con actividad: una tarjeta por estadística (se arman desde el código) -->
                        <StackPanel x:Name="pnlEstadisticas" Margin="0,6,0,0">
                            <UniformGrid x:Name="gridAvance" Columns="4" Margin="-6,0"/>
                            <UniformGrid x:Name="gridRespuestas" Columns="3" Margin="-6,0"/>
                        </StackPanel>

                        <!-- Sin actividad: invitación a empezar en vez de ceros sueltos -->
                        <Grid x:Name="pnlSinActividad" Margin="0,16,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource BrushAccentSoft}" VerticalAlignment="Top">
                                <TextBlock Text="&#xE7BE;" FontFamily="{StaticResource FontIconos}" FontSize="30"
                                           Foreground="{DynamicResource BrushAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Todavía no practicaste" FontFamily="{StaticResource FontHeading}" FontSize="19"
                                           FontWeight="Bold" Foreground="{DynamicResource BrushInk}"/>
                                <TextBlock Text="Cuando respondas en Aprender o en Desafío, acá vas a ver tus aciertos, tu racha y tus puntos."
                                           FontSize="13.5" Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <Button x:Name="btnEmpezar" Style="{StaticResource PrimaryButton}" Width="210" HorizontalAlignment="Left"
                                        Margin="0,16,0,0" Click="BtnEmpezar_Click"
                                        AutomationProperties.Name="Empezar en Aprender">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Empezar en Aprender" VerticalAlignment="Center"/>
                                        <TextBlock Text="  →" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Tarjeta: estadísticas por categoría (se arman desde el código con ProgresoSenas) -->
                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1.5"
                        CornerRadius="18" Padding="26,18" Margin="0,12,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource FontIconos}" FontSize="16"
                                       Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center"/>
                            <TextBlock Text="POR CATEGORÍA" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushMuted}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Sin datos (o si falla la base): un mensaje en lugar de la lista -->
                        <TextBlock x:Name="lblCategoriasMensaje" FontSize="13.5" Foreground="{DynamicResource BrushMuted}"
                                   TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>

                        <!-- Las categorías con menor precisión, con un botón para practicarlas -->
                        <StackPanel x:Name="pnlReforzar" Margin="0,14,0,0" Visibility="Collapsed">
                            <TextBlock Text="Para practicar más" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource BrushInk}"/>
                            <StackPanel x:Name="lstReforzar" Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- Una fila por cada categoría practicada -->
                        <StackPanel x:Name="pnlCategoriasPracticadas" Margin="0,14,0,0" Visibility="Collapsed">
                            <TextBlock Text="Categorías que practicaste" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource BrushInk}"/>
                            <StackPanel x:Name="lstCategorias" Margin="-6,4,-6,0"/>
                        </StackPanel>

                        <TextBlock x:Name="lblSinPracticar" FontSize="12.5" Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap"
                                   Margin="0,10,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Tarjeta: cuenta (story "gestionar mi cuenta") -->
                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1.5"
                        CornerRadius="18" Padding="26,18" Margin="0,12,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" FontFamily="{StaticResource FontIconos}" FontSize="16"
                                       Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center"/>
                            <TextBlock Text="CUENTA" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushMuted}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="btnEditarNombre" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                                    Click="BtnEditarNombre_Click" AutomationProperties.Name="Editar tu nombre">
                                <StackPanel Orientation="Horizontal" Margin="16,0">
                                    <TextBlock Text="&#xE70F;" FontFamily="{StaticResource FontIconos}" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Editar nombre" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnCambiarPassword" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                                    Click="BtnCambiarPassword_Click" AutomationProperties.Name="Cambiar tu contraseña">
                                <StackPanel Orientation="Horizontal" Margin="16,0">
                                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource FontIconos}" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Cambiar contraseña" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnCerrarSesion" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                                    Click="BtnCerrarSesion_Click" AutomationProperties.Name="Cerrar sesión y volver al inicio de sesión">
                                <StackPanel Orientation="Horizontal" Margin="16,0">
                                    <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource FontIconos}" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Cerrar sesión" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <!-- Acciones que no se pueden deshacer: piden confirmación en un diálogo -->
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="btnReiniciar" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                                    Click="BtnReiniciar_Click" AutomationProperties.Name="Reiniciar tu progreso. Pide confirmación">
                                <StackPanel Orientation="Horizontal" Margin="16,0">
                                    <TextBlock Text="&#xE777;" FontFamily="{StaticResource FontIconos}" FontSize="14" VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrushError}"/>
                                    <TextBlock Text="Reiniciar progreso" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrushError}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnEliminarPerfil" Style="{StaticResource SecondaryButton}"
                                    Click="BtnEliminarPerfil_Click" AutomationProperties.Name="Eliminar tu perfil. Pide tu contraseña y confirmación">
                                <StackPanel Orientation="Horizontal" Margin="16,0">
                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource FontIconos}" FontSize="14" VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrushError}"/>
                                    <TextBlock Text="Eliminar perfil" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrushError}"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <!-- Cambio de contraseña: actual, nueva (con el checklist del registro) y confirmación -->
                        <StackPanel x:Name="pnlPassword" Visibility="Collapsed" Margin="0,16,0,0" MaxWidth="420" HorizontalAlignment="Left">
                            <TextBlock Text="Contraseña actual" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="txtPasswordActual" Style="{StaticResource RoundedPasswordBox}" Width="420"
                                         KeyDown="CampoPassword_KeyDown" LostFocus="TxtPasswordActual_LostFocus"
                                         PasswordChanged="TxtPasswordActual_PasswordChanged" AutomationProperties.Name="Contraseña actual"/>
                            <!-- Se verifica al salir del campo (o con Enter): avisa antes de Guardar -->
                            <TextBlock x:Name="lblEstadoActual" FontSize="12.5" Margin="2,5,0,0" Visibility="Collapsed"
                                       AutomationProperties.LiveSetting="Assertive"/>
                            <TextBlock Text="Contraseña nueva" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                            <PasswordBox x:Name="txtPasswordNueva" Style="{StaticResource RoundedPasswordBox}" Width="420"
                                         PasswordChanged="TxtPasswordNueva_PasswordChanged" KeyDown="CampoPassword_KeyDown"
                                         AutomationProperties.Name="Contraseña nueva: 8 caracteres o más, al menos una mayúscula y sin espacios"/>
                            <!-- Checklist en vivo de PoliticaPassword: "○" sin escribir; con texto, "✓" en verde si se cumple
                                 y "✗" en rojo si no (el símbolo cambia además del color) -->
                            <ItemsControl x:Name="lstReglas" Margin="2,6,0,0" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="regla" FontSize="11.5" Margin="0,0,16,0" Foreground="{DynamicResource BrushMuted}">
                                            <Run x:Name="icono" Text="○"/><Run Text=" "/><Run Text="{Binding Descripcion, Mode=OneWay}"/>
                                        </TextBlock>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Estado}" Value="ok">
                                                <Setter TargetName="regla" Property="Foreground" Value="{DynamicResource BrushSuccess}"/>
                                                <Setter TargetName="regla" Property="FontWeight" Value="SemiBold"/>
                                                <Setter TargetName="icono" Property="Text" Value="✓"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Estado}" Value="error">
                                                <Setter TargetName="regla" Property="Foreground" Value="{DynamicResource BrushError}"/>
                                                <Setter TargetName="regla" Property="FontWeight" Value="SemiBold"/>
                                                <Setter TargetName="icono" Property="Text" Value="✗"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Repetí la contraseña nueva" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                            <PasswordBox x:Name="txtPasswordConfirmar" Style="{StaticResource RoundedPasswordBox}" Width="420"
                                         KeyDown="CampoPassword_KeyDown" PasswordChanged="TxtPasswordConfirmar_PasswordChanged"
                                         AutomationProperties.Name="Repetí la contraseña nueva. Enter para guardar"/>
                            <TextBlock x:Name="lblEstadoConfirmar" FontSize="12.5" Margin="2,5,0,0" Visibility="Collapsed"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Height="40" Width="170" Content="Guardar contraseña"
                                        Click="BtnGuardarPassword_Click" AutomationProperties.Name="Guardar la contraseña nueva"/>
                                <Button Style="{StaticResource SecondaryButton}" Height="40" Width="110" Margin="8,0,0,0" Content="Cancelar"
                                        Click="BtnCancelarPassword_Click" AutomationProperties.Name="Cancelar el cambio de contraseña"/>
                            </StackPanel>
                            <TextBlock x:Name="lblErrorPassword" FontSize="13" Foreground="{DynamicResource BrushError}" TextWrapping="Wrap"
                                       Margin="2,8,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"/>
                        </StackPanel>

                        <!-- Edición del nombre: Enter guarda, Esc cancela -->
                        <StackPanel x:Name="pnlEditarNombre" Visibility="Collapsed" Margin="0,16,0,0">
                            <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="360"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtNombre" Style="{StaticResource RoundedTextBox}" MaxLength="60"
                                         KeyDown="TxtNombre_KeyDown" AutomationProperties.Name="Nuevo nombre. Enter para guardar, Escape para cancelar"/>
                                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Height="40" Width="110"
                                        Content="Guardar" Click="BtnGuardarNombre_Click" AutomationProperties.Name="Guardar el nombre"/>
                                <Button Grid.Column="4" Style="{StaticResource SecondaryButton}" Height="40" Width="110"
                                        Content="Cancelar" Click="BtnCancelarNombre_Click" AutomationProperties.Name="Cancelar la edición del nombre"/>
                            </Grid>
                            <TextBlock x:Name="lblErrorNombre" FontSize="13" Foreground="{DynamicResource BrushError}" TextWrapping="Wrap"
                                       Margin="2,6,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"/>
                        </StackPanel>

                        <!-- Confirmación después de guardar (con símbolo, no solo color) -->
                        <TextBlock x:Name="lblCuentaOk" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushSuccess}"
                                   Margin="2,12,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
